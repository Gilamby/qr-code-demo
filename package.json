{
  "name": "optimasys-qr",
  "version": "0.1.0",
  "private": true,
  "description": "Optimasys QR: QR-codes maken, beheren en meten (web-app met eigen server en SQLite-database)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "backup": "node scripts/backup.js",
    "migrate": "node scripts/migrate-json.js",
    "build:demo": "node scripts/build-demo.js",
    "share": "node scripts/share.js",
    "migrate:pg": "node scripts/migrate-to-postgres.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "maxmind": "^5.0.7",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1"
  },
  "optionalDependencies": {
    "@ip-location-db/dbip-city-mmdb": "2.3.2026060513",
    "cloudflared": "0.7.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
