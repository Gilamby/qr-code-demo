{
  "name": "optimasys-qr",
  "version": "0.1.0",
  "private": true,
  "description": "Optimasys QR: QR-codes maken, beheren en meten (web-app met eigen server en SQLite-database)",
  "main": "server/dist/main.js",
  "scripts": {
    "start": "node server/dist/main.js",
    "dev": "npm run -s build:server && (tsc -p server -w --preserveWatchOutput > /dev/null & node --watch server/dist/main.js)",
    "build": "npm run -s build:server && node scripts/build.js",
    "test": "npm run -s build:server && node --test test/*.test.js",
    "backup": "npm run -s build:server && node scripts/backup.js",
    "migrate": "npm run -s build:server && node scripts/migrate-json.js",
    "build:demo": "node scripts/build-demo.js",
    "share": "npm run -s build:server && node scripts/share.js",
    "migrate:pg": "npm run -s build:server && node scripts/migrate-to-postgres.js",
    "build:server": "node scripts/build-server.js",
    "prestart": "npm run -s build:server"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "better-sqlite3": "^11.10.0",
    "express": "^5.2.1",
    "maxmind": "^5.0.7",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "optionalDependencies": {
    "@ip-location-db/dbip-city-mmdb": "2.3.2026060513",
    "cloudflared": "0.7.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  }
}
