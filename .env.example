# Kopieer dit bestand naar .env en vul in. Alles is optioneel; zonder .env draait de app lokaal.

# Webadres waarop de app bereikbaar is (wordt gebruikt in de korte links en e-mails)
PUBLIC_URL=https://qr.optimasys.com
PORT=3000
# Zet op production bij echte hosting (veilige cookies, caching)
NODE_ENV=production
# Achter nginx/hosting-proxy: welke proxy mag het IP-adres van de bezoeker doorgeven
# "loopback" (nginx op dezelfde machine), een getal (Railway/Render: 1) of "true"
TRUST_PROXY=loopback

# Database. Het begin van DATABASE_URL bepaalt welke:
#   mongodb://…  of mongodb+srv://…  -> MongoDB (Optimasys-hosting, zie docs/hosting.md)
#   postgres://…                     -> PostgreSQL
#   leeg                             -> SQLite-bestand in DATA_DIR (handig om te ontwikkelen, niets te installeren)
# DATABASE_URL=mongodb://optimasys_qr:wachtwoord@127.0.0.1:27017/optimasys_qr?authSource=optimasys_qr
# DATABASE_URL=postgres://optimasys:wachtwoord@db-host:5432/optimasys?sslmode=require
# PG_POOL_MAX=10

# Opslag voor bestanden (PDF/MP3), secret.key en, bij SQLite, de database. Buiten de app-map houden. Standaard: server/data
# DATA_DIR=/var/lib/optimasys-qr
# Adres waarop de server luistert (achter nginx: 127.0.0.1)
# HOST=127.0.0.1

# Sleutel voor versleutelde velden (wifi-wachtwoorden): 64 hex-tekens. Maak er een met: openssl rand -hex 32
# Leeg = de app maakt zelf <DATA_DIR>/secret.key. Bewaar de sleutel apart van de database-back-ups.
DATA_KEY=

# E-mail voor accountbevestiging en "wachtwoord vergeten" (zonder: de link staat in de serverlog)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Optimasys QR <no-reply@optimasys.com>

# Land/stad bij statistieken: pad naar de maandelijkse DB-IP-download (zie docs/statistieken.md)
# GEO_DB=/var/lib/optimasys/geo/dbip-city-lite.mmdb

# Eigen adres-zoekserver (Photon); standaard de openbare server (alleen licht gebruik)
# PHOTON_URL=https://photon.komoot.io

# Geheim voor bestandslinks van beveiligde pagina's (lang, willekeurig). Leeg = nieuw bij elke start.
FILE_SECRET=
