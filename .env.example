# Kopieer dit bestand naar .env en vul in. Alles is optioneel; zonder .env draait de app lokaal.

# Webadres waarop de app bereikbaar is (wordt gebruikt in de korte links en e-mails)
PUBLIC_URL=https://qr.optimasys.com
PORT=3000
# Zet op production bij echte hosting (veilige cookies, caching)
NODE_ENV=production
# Achter nginx/hosting-proxy: welke proxy mag het IP-adres van de bezoeker doorgeven
# "loopback" (nginx op dezelfde machine), een getal (Railway/Render: 1) of "true"
TRUST_PROXY=loopback

# Database. Het begin van DATABASE_URL bepaalt welke:
#   mongodb://…  of mongodb+srv://…  -> MongoDB (Optimasys-hosting, zie docs/hosting.md)
#   postgres://…                     -> PostgreSQL
#   leeg                             -> SQLite-bestand in DATA_DIR (handig om te ontwikkelen, niets te installeren)
# DATABASE_URL=mongodb://optimasys_qr:wachtwoord@127.0.0.1:27017/optimasys_qr?authSource=optimasys_qr
# DATABASE_URL=postgres://optimasys:wachtwoord@db-host:5432/optimasys?sslmode=require
# PG_POOL_MAX=10

# Opslag voor bestanden (PDF/MP3), secret.key en, bij SQLite, de database. Buiten de app-map houden. Standaard: server/data
# DATA_DIR=/var/lib/optimasys-qr
# Adres waarop de server luistert (achter nginx: 127.0.0.1)
# HOST=127.0.0.1

# Sleutel voor versleutelde velden (wifi-wachtwoorden): 64 hex-tekens. Maak er een met: openssl rand -hex 32
# Leeg = de app maakt zelf <DATA_DIR>/secret.key. Bewaar de sleutel apart van de database-back-ups.
DATA_KEY=

# Licentie: klanten maken niet zelf een account. Het team voegt ze toe op de pagina Klanten
# (de klant krijgt een mail om een wachtwoord te kiezen, 7 dagen geldig).
# Vast team-account: wordt bij het opstarten aangemaakt (al bevestigd) als het nog niet bestaat.
# Het wachtwoord staat alleen hier op de server. Minstens 8 tekens.
# SUPPORT_EMAIL=support@optimasys.com
# SUPPORT_PASSWORD=
# SUPPORT_NAME=Optimasys Support
# Meer team-leden (zien ook de pagina Klanten), komma's ertussen:
# ADMIN_EMAILS=
# Extra super-admins (naast SUPPORT_EMAIL), komma's ertussen. Kunnen admins maken en worden nooit uitgezet of verwijderd.
# SUPER_ADMIN_EMAILS=
# Zelf een account maken toestaan (alleen om te testen/ontwikkelen): true
# ALLOW_SIGNUP=

# Inloggen met Google (optioneel). Google Cloud Console > API's en services > Inloggegevens > OAuth-client-ID,
# type Webapplicatie, toegestane omleidings-URI: <PUBLIC_URL>/api/auth/google/callback. Leeg = geen Google-knop.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Inloggen met Microsoft (optioneel). portal.azure.com > App registrations > New registration,
# "Accounts in any organizational directory and personal Microsoft accounts", Redirect URI (Web):
# <PUBLIC_URL>/api/auth/microsoft/callback. Token configuration: optionele claims email en xms_edov (ID-token).
# Certificates & secrets > New client secret. Leeg = geen Microsoft-knop.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# E-mail voor accountbevestiging en "wachtwoord vergeten" (zonder: de link staat in de serverlog)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=QR-Codex <no-reply@optimasys.com>

# Maximale grootte van een geüploade video in MB (standaard 100; nginx: client_max_body_size voor /api/uploads/)
# VIDEO_MAX_MB=100

# Land/stad bij statistieken: pad naar de maandelijkse DB-IP-download (zie docs/statistieken.md)
# GEO_DB=/var/lib/optimasys/geo/dbip-city-lite.mmdb

# Eigen adres-zoekserver (Photon); standaard de openbare server (alleen licht gebruik)
# PHOTON_URL=https://photon.komoot.io

# Geheim voor bestandslinks van beveiligde pagina's (lang, willekeurig). Leeg = nieuw bij elke start.
FILE_SECRET=

# Demo-afrekenen: staat vanzelf aan zolang STRIPE_SECRET_KEY leeg is (er wordt niets afgeschreven, het pakket gaat wel aan).
# Zodra Stripe is ingesteld, is de demo vanzelf uit. Toch uitzetten zonder Stripe: DEMO_CHECKOUT=false
# DEMO_CHECKOUT=false

# Betalen met Stripe (Terms punt 4 en 5). Leeg = demo-afrekenen (zie DEMO_CHECKOUT).
# dashboard.stripe.com > Developers > API keys: Secret key (testmodus: sk_test_…, live: sk_live_…)
# STRIPE_SECRET_KEY=
# Developers > Webhooks > Add endpoint: <PUBLIC_URL>/api/billing/webhook, events:
#   checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted, invoice.paid
# Daarna de "Signing secret" (whsec_…):
# STRIPE_WEBHOOK_SECRET=
# Betalen in de app zelf (eigen betaalpagina in de stijl van de app). Developers > API keys: Publishable key (pk_test_… / pk_live_…).
# Deze sleutel is openbaar (hij staat ook in de browser). Leeg = de betaalpagina van Stripe zelf.
# STRIPE_PUBLISHABLE_KEY=
# Btw voor particulieren: standaard altijd 21% Spaanse IVA (mag zolang OptimaSys onder EUR 10.000 per jaar aan particulieren
# in andere EU-landen blijft). Daarboven: PRIVATE_VAT=country = btw van het land van de klant (Stripe Tax, OSS).
# PRIVATE_VAT=country
# Eigen facturen (reeksen ES, UE, CN, EX; ook voor Flexichat-betalingen in hetzelfde Stripe-account). Gegevens van OptimaSys op de factuur.
# Met een live-sleutel (sk_live_) zonder CIF wordt geen factuur gemaakt. Adresregels gescheiden door |.
# INVOICE_SELLER_NAME=OptimaSys
# INVOICE_SELLER_TAX_ID=
# INVOICE_SELLER_ADDRESS=Calle Alfredo Palma 10|29603 Marbella (Málaga)|España
# Afzender van de factuurmail (anders MAIL_FROM)
# INVOICE_MAIL_FROM=OptimaSys <facturas@optimasys.es>
# Cloudflare Turnstile ("ben je een mens?") bij Account maken en Wachtwoord vergeten. Beide leeg = uit.
# Site key mag in de browser; de secret key alleen hier. Domein in Cloudflare: my.qr-codex.com
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Eén keer in Stripe: Settings > Billing > Customer portal > opzeggen en facturen aanzetten, opslaan.

# Eigen domein voor klanten (Business): korte links als https://qr.klantmerk.nl/q/…  Uit zolang dit leeg is.
# Uitleg en Cloudflare-instellingen: docs/hosting.md, hoofdstuk 9.
# CUSTOM_DOMAIN_TARGET=domains.qr-codex.com
# CF_API_TOKEN=
# CF_ZONE_ID=

# Maximaal aantal apparaten tegelijk ingelogd per account (standaard 3). Een vierde login logt het langst niet gebruikte apparaat uit.
# MAX_DEVICES=3
