# Website qr-codex.com — kopieer naar .env en vul in (nooit in Git)
# Leeg = SQLite-bestand website.db (prima om mee te beginnen). Later MongoDB: zelfde Atlas-cluster als de app, eigen database-naam
DATABASE_URI=
# DATABASE_URI=mongodb+srv://USER:WACHTWOORD@cluster.mongodb.net/qrcodex-website
# Geheime sleutel: wordt vanzelf ingevuld bij npm run build
PAYLOAD_SECRET=
# Adres van deze website en van de app
SITE_URL=https://qr-codex.com
NEXT_PUBLIC_APP_URL=https://my.qr-codex.com
PORT=3200
# Eerste beheerder van /admin (alleen gebruikt als er nog geen beheerder is; daarna mag dit eruit)
ADMIN_EMAIL=
ADMIN_PASSWORD=
