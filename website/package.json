{
  "name": "qr-codex-website",
  "version": "0.1.0",
  "private": true,
  "description": "Website qr-codex.com (Next.js + Payload CMS) om de QR-Codex-app te promoten",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "node scripts/env.mjs && next build",
    "start": "node scripts/env.mjs && next start -p ${PORT:-3200}",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@payloadcms/db-mongodb": "3.91.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "graphql": "^16.14.2",
    "next": "15.4.11",
    "payload": "3.91.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/three": "^0.170.0",
    "typescript": "5.9"
  }
